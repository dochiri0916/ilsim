diff --git a/src/test/java/com/x/post/PostControllerTest.java b/src/test/java/com/x/post/PostControllerTest.java
--- a/src/test/java/com/x/post/PostControllerTest.java
+++ b/src/test/java/com/x/post/PostControllerTest.java
@@ -1,3 +1,36 @@
+package com.x.post;
+
+@SpringBootTest
+@AutoConfigureMockMvc
+class PostControllerTest {
+
+    @Autowired
+    MockMvc mockMvc;
+
+    @Autowired
+    PostRepository postRepository;
+
+    @BeforeEach
+    void setUp() {
+        for (int i = 1; i <= 25; i++) {
+            postRepository.save(new Post("글 " + i, "kim"));
+        }
+    }
+
+    @Test
+    @WithMockUser
+    void 첫_페이지는_20개와_페이지_정보를_돌려준다() throws Exception {
+        mockMvc.perform(get("/posts").param("page", "0"))
+                .andExpect(status().isOk())
+                .andExpect(jsonPath("$.content.length()").value(20))
+                .andExpect(jsonPath("$.page").value(0))
+                .andExpect(jsonPath("$.totalPages").value(2))
+                .andExpect(jsonPath("$.hasNext").value(true))
+                .andExpect(jsonPath("$.content[0].id").exists())
+                .andExpect(jsonPath("$.content[0].title").exists())
+                .andExpect(jsonPath("$.content[0].authorName").exists())
+                .andExpect(jsonPath("$.content[0].createdAt").exists());
+    }
 }
