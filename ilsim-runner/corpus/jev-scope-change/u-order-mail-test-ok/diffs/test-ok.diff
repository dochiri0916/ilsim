diff --git a/src/test/kotlin/com/x/mail/OrderMailListenerTest.kt b/src/test/kotlin/com/x/mail/OrderMailListenerTest.kt
--- a/src/test/kotlin/com/x/mail/OrderMailListenerTest.kt
+++ b/src/test/kotlin/com/x/mail/OrderMailListenerTest.kt
@@ -1,3 +1,19 @@
+package com.x.mail
+
+class OrderMailListenerTest {
+
+    private val memberRepository = mockk<MemberRepository>()
+    private val mailSender = mockk<MailSender>(relaxed = true)
+    private val mailLogRepository = mockk<MailLogRepository>(relaxed = true)
+    private val listener = OrderMailListener(memberRepository, mailSender, mailLogRepository)
+    private val order = Order(no = "A-100", items = listOf(OrderItem("책", 2)), amount = 30_000)
+
+    @Test
+    fun `결제 완료되면 주문번호·상품·금액을 담은 메일을 보내고 기록한다`() {
+        every { memberRepository.findById(1L) } returns Optional.of(Member(1L, "a@x.com"))
+        listener.onPaid(OrderPaidEvent(1L, order))
+        verify { mailSender.send("a@x.com", "[샵] 주문이 완료됐습니다 (A-100)", match { it.contains("A-100") && it.contains("책") && it.contains("30,000") }) }
+        verify { mailLogRepository.save(any()) }
+    }
 }
