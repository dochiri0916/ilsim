@@ -0,0 +1,9 @@
+package com.x.member
+
+@RestController
+class MemberController(private val memberService: MemberService) {
+
+    @PostMapping("/members")
+    fun join(@RequestBody @Valid request: JoinRequest): ResponseEntity<JoinResponse> =
+        ResponseEntity.status(HttpStatus.CREATED).body(JoinResponse(memberService.join(request.toCommand())))
+}
