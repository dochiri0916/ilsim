+++ b/src/main/kotlin/com/x/member/MemberService.kt
@@ -0,0 +1,18 @@
+package com.x.member
+
+@Service
+class MemberService(
+    private val memberRepository: MemberRepository,
+    private val passwordEncoder: PasswordEncoder,
+    private val events: ApplicationEventPublisher,
+) {
+
+    @Transactional
+    fun join(command: JoinCommand): Long {
+        if (memberRepository.existsByEmailIgnoreCase(command.email)) throw DuplicateEmailException(command.email)
+        require(command.password.length >= 8) { "password must be at least 8 characters" }
+        val member = memberRepository.save(Member(command.email, passwordEncoder.encode(command.password), command.nickname))
+        events.publishEvent(MemberJoinedEvent(member.id!!))
+        return member.id!!
+    }
+}
