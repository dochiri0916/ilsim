+package com.x.member
+
+@SpringBootTest
+@AutoConfigureMockMvc
+class MemberControllerTest(@Autowired private val mockMvc: MockMvc) {
+
+    @Test
+    fun `비밀번호가 8자보다 짧으면 400을 돌려준다`() {
+        mockMvc.post("/members") {
+            contentType = MediaType.APPLICATION_JSON
+            content = """{"email":"g@x.com","password":"pw1","nickname":"kim"}"""
+        }.andExpect { status { isBadRequest() } }
+    }
+}
