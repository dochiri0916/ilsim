diff --git a/src/main/java/com/x/post/PostQueryService.java b/src/main/java/com/x/post/PostQueryService.java
new file mode 100644
--- /dev/null
+++ b/src/main/java/com/x/post/PostQueryService.java
@@ -0,0 +1,16 @@
+package com.x.post;
+
+@Service
+@Transactional(readOnly = true)
+@RequiredArgsConstructor
+public class PostQueryService {
+
+    private static final int PAGE_SIZE = 20;
+
+    private final PostRepository postRepository;
+
+    public PostPageResponse list(int page) {
+        Page<Post> posts = postRepository.findAllByDeletedFalse(PageRequest.of(page, PAGE_SIZE, Sort.by(Sort.Direction.DESC, "createdAt")));
+        return PostPageResponse.from(posts);
+    }
+}
diff --git a/src/main/java/com/x/post/PostController.java b/src/main/java/com/x/post/PostController.java
