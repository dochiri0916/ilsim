diff --git a/src/main/java/com/x/coupon/CouponService.java b/src/main/java/com/x/coupon/CouponService.java
--- a/src/main/java/com/x/coupon/CouponService.java
+++ b/src/main/java/com/x/coupon/CouponService.java
@@ -12,6 +12,26 @@ public class CouponService {
     private final CouponRepository couponRepository;
     private final Clock clock;
+
+    @Transactional
+    public long use(Long couponId, Long memberId, long orderAmount) {
+        Coupon coupon = couponRepository.findById(couponId).orElseThrow(CouponNotFoundException::new);
+        if (!coupon.isOwnedBy(memberId)) {
+            throw new CouponOwnerMismatchException();
+        }
+        if (coupon.isUsed()) {
+            throw new CouponAlreadyUsedException();
+        }
+        if (coupon.isExpiredAt(LocalDateTime.now(clock))) {
+            throw new CouponExpiredException();
+        }
+        coupon.use();
+        return coupon.getDiscountAmount();
+    }
 }
diff --git a/src/main/java/com/x/coupon/Coupon.java b/src/main/java/com/x/coupon/Coupon.java
--- a/src/main/java/com/x/coupon/Coupon.java
+++ b/src/main/java/com/x/coupon/Coupon.java
@@ -30,4 +30,17 @@ public class Coupon {
     private boolean used;

     protected Coupon() {
     }
+
+    public boolean isOwnedBy(Long memberId) {
+        return this.memberId.equals(memberId);
+    }
+
+    public boolean isExpiredAt(LocalDateTime now) {
+        return now.isAfter(expiresAt);
+    }
+
+    public void use() {
+        this.used = true;
+    }
 }
