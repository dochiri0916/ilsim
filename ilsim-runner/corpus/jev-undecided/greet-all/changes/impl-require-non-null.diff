diff --git a/src/main/java/demo/Greeter.java b/src/main/java/demo/Greeter.java
--- a/src/main/java/demo/Greeter.java
+++ b/src/main/java/demo/Greeter.java
@@ -1,8 +1,20 @@
 package demo;

+import java.util.List;
+import java.util.Objects;
+
 public class Greeter {

     public String greet(String name) {
         return "Hello, " + name;
     }
+
+    public List<String> greetAll(List<String> names) {
+        Objects.requireNonNull(names, "names must not be null");
+        return names.stream()
+                .map(name -> Messages.HELLO + ", " + Names.normalize(Objects.requireNonNull(name, "name must not be null")) + ".")
+                .toList();
+    }
 }
