diff --git a/src/test/java/demo/GreeterTest.java b/src/test/java/demo/GreeterTest.java
--- a/src/test/java/demo/GreeterTest.java
+++ b/src/test/java/demo/GreeterTest.java
@@ -1,13 +1,34 @@
 package demo;

+import java.util.List;
 import org.junit.jupiter.api.DisplayName;
 import org.junit.jupiter.api.Test;

 import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;

 class GreeterTest {

     @Test
     void greets() {
         assertThat(new Greeter().greet("Kim")).isEqualTo("Hello, Kim");
     }
+
+    @Test
+    @DisplayName("이름마다 입력 순서대로 인사 문구를 만든다")
+    void greetsAllInOrder() {
+        assertThat(new Greeter().greetAll(List.of("Kim", "Lee")))
+                .containsExactly("Hello, Kim.", "Hello, Lee.");
+    }
+
+    @Test
+    @DisplayName("이름 앞뒤 공백을 지운다")
+    void trimsNames() {
+        assertThat(new Greeter().greetAll(List.of("  Kim "))).containsExactly("Hello, Kim.");
+    }
+
+    @Test
+    @DisplayName("공백뿐인 이름이 있으면 예외를 던진다")
+    void rejectsBlankName() {
+        assertThatThrownBy(() -> new Greeter().greetAll(List.of("Kim", "   ")))
+                .isInstanceOf(IllegalArgumentException.class)
+                .hasMessage("name must not be blank");
+    }
 }
