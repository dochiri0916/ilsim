 package demo;
 
+import java.util.List;
+
 public class Greeter {
     public String greet(String name) {
         return "Hello, " + name;
     }
+
+    public List<String> greetAll(List<String> names) {
+        return names.stream()
+                .map(name -> Messages.HELLO + ", " + Names.normalize(name) + ".")
+                .toList();
+    }
 }
