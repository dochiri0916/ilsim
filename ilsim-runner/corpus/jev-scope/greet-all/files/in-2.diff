+public final class Names {
+    private Names() {
+    }
+
+    public static String normalize(String name) {
+        String normalized = name.strip();
+        if (normalized.isEmpty()) {
+            throw new IllegalArgumentException("name must not be blank");
+        }
+        return normalized;
+    }
