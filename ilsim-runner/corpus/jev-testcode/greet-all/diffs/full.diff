--- /dev/null
+++ b/src/test/java/demo/GreeterTest.java
@@ -0,0 +1,37 @@
+package demo;
+
+import java.util.List;
+import org.junit.jupiter.api.Assumptions;
+import org.junit.jupiter.api.DisplayName;
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+class GreeterTest {
+    @Test
+    @DisplayName("이름마다 인사 문구를 만든다")
+    void greetsAll() {
+        assertThat(new Greeter().greetAll(List.of("Kim", "Lee"))).containsExactly("Hello, Kim.", "Hello, Lee.");
+    }
+
+    @Test
+    @DisplayName("입력 순서를 지킨다")
+    void keepsOrder() {
+        assertThat(new Greeter().greetAll(List.of("Lee", "Kim"))).containsExactly("Hello, Lee.", "Hello, Kim.");
+    }
+
+    @Test
+    @DisplayName("이름 앞뒤 공백을 지운다")
+    void trimsNames() {
+        assertThat(new Greeter().greetAll(List.of("  Kim "))).containsExactly("Hello, Kim.");
+    }
+
+    @Test
+    @DisplayName("공백뿐인 이름이 있으면 예외를 던진다")
+    void rejectsBlankName() {
+        assertThatThrownBy(() -> new Greeter().greetAll(List.of("Kim", "   ")))
+                .isInstanceOf(IllegalArgumentException.class)
+                .hasMessage("name must not be blank");
+    }
+}
