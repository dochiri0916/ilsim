@@ -0,0 +1,17 @@
+package com.x.member
+
+@SpringBootTest
+@AutoConfigureMockMvc
+class MemberControllerTest(@Autowired private val mockMvc: MockMvc) {
+
+    @Test
+    fun `가입하면 201과 회원 id를 돌려준다`() {
+        mockMvc.post("/members") {
+            contentType = MediaType.APPLICATION_JSON
+            content = """{"email":"e@x.com","password":"pw123456","nickname":"kim"}"""
+        }.andExpect {
+            status { isCreated() }
+            jsonPath("$.id") { exists() }
+        }
+    }
+}
