+package com.dochiri.ilsim
+
+import java.nio.file.Path
+import kotlin.io.path.readText
+import kotlin.test.Test
+import kotlin.test.assertTrue
+
+class HandoffGuidelineScoresTest {
+    private val root = Path.of("..").toAbsolutePath().normalize()
+
+    private fun git(vararg args: String): String {
+        val process = ProcessBuilder(listOf("git") + args).directory(root.toFile()).redirectErrorStream(true).start()
+        val out = process.inputStream.bufferedReader().readText()
+        check(process.waitFor() == 0) { "git ${args.joinToString(" ")} 실패: $out" }
+        return out
+    }
+
+    private fun diffBase(): String? = git("rev-parse", "--verify", "-q", "main").trim().ifEmpty { null }
+
+    @Test
+    fun `TC-1 문서별 최종 관련도 줄을 적는다`() {
+        val text = root.resolve("docs/handoff.md").readText()
+        assertTrue("문서별 최종 관련도" in text)
+    }
+}
