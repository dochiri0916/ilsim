diff --git a/build-convention/core/src/main/java/com/dochiri/convention/rule/TestMethodNameRule.java b/build-convention/core/src/main/java/com/dochiri/convention/rule/TestMethodNameRule.java
new file mode 100644
--- /dev/null
+++ b/build-convention/core/src/main/java/com/dochiri/convention/rule/TestMethodNameRule.java
@@ -0,0 +1,23 @@
+package com.dochiri.convention.rule;
+
+import com.dochiri.convention.model.SourceFile;
+import com.dochiri.convention.model.Violation;
+import java.util.List;
+import java.util.regex.Pattern;
+
+public final class TestMethodNameRule implements ValidationRule {
+    private static final Pattern NAME = Pattern.compile("[a-z][A-Za-z0-9]*|`[^`]+`");
+
+    @Override
+    public String id() {
+        return "TEST-NAME-001";
+    }
+
+    @Override
+    public List<Violation> check(SourceFile file) {
+        return file.testMethods().stream()
+            .filter(method -> !NAME.matcher(method.name()).matches())
+            .map(method -> Violation.of(id(), file.path(), method.line(), "테스트 메서드 이름 형식이 맞지 않습니다"))
+            .toList();
+    }
+}
