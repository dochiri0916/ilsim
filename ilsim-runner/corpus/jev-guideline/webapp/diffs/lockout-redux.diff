diff --git a/src/features/login/LoginForm.tsx b/src/features/login/LoginForm.tsx
new file mode 100644
--- /dev/null
+++ b/src/features/login/LoginForm.tsx
@@ -0,0 +1,33 @@
+import { useDispatch, useSelector } from 'react-redux';
+import styles from './LoginForm.module.css';
+import { useLogin } from './useLogin';
+import { loginFailed, loginSucceeded, selectLogin } from '../../shared/store/loginSlice';
+
+const MAX_FAILURES = 5;
+const LOCK_MS = 10 * 60 * 1000;
+
+export function LoginForm() {
+  const dispatch = useDispatch();
+  const { failures, lockedUntil } = useSelector(selectLogin);
+  const login = useLogin();
+  const locked = lockedUntil !== null && Date.now() < lockedUntil;
+
+  async function submit(form: FormData) {
+    const success = await login.mutateAsync({ email: String(form.get('email')), password: String(form.get('password')) });
+    if (success) {
+      dispatch(loginSucceeded());
+      return;
+    }
+    dispatch(loginFailed({ lockUntil: failures + 1 >= MAX_FAILURES ? Date.now() + LOCK_MS : null }));
+  }
+
+  return (
+    <form action={submit} className={styles.form}>
+      <label>이메일<input name="email" type="email" /></label>
+      <label>비밀번호<input name="password" type="password" /></label>
+      {locked && <p role="alert" className={styles.error}>잠시 후 다시 시도하세요.</p>}
+      {!locked && failures > 0 && <p role="alert" className={styles.error}>이메일 또는 비밀번호가 올바르지 않습니다.</p>}
+      <button type="submit" disabled={locked}>로그인</button>
+    </form>
+  );
+}
diff --git a/src/features/login/useLogin.ts b/src/features/login/useLogin.ts
new file mode 100644
--- /dev/null
+++ b/src/features/login/useLogin.ts
@@ -0,0 +1,10 @@
+import { useMutation } from '@tanstack/react-query';
+import { apiClient } from '../../api/client';
+import type { LoginResponse } from '../../api/types';
+
+export function useLogin() {
+  return useMutation({
+    mutationFn: (body: { email: string; password: string }) =>
+      apiClient.post<LoginResponse>('/auth/login', body).then((response) => response.data.success),
+  });
+}
