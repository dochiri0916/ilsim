@@ -0,0 +1,41 @@
+import { useState } from 'react';
+import styles from './LoginForm.module.css';
+import { useLogin } from './useLogin';
+import { useProfile } from '../profile/useProfile';
+
+const MAX_FAILURES = 5;
+const LOCK_MS = 10 * 60 * 1000;
+
+export function LoginForm() {
+  const [failures, setFailures] = useState(0);
+  const [lockedUntil, setLockedUntil] = useState<number | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const login = useLogin();
+  const locked = lockedUntil !== null && Date.now() < lockedUntil;
+  const profile = useProfile();
+
+  async function submit(form: FormData) {
+    const success = await login.mutateAsync({ email: String(form.get('email')), password: String(form.get('password')) });
+    if (success) {
+      setFailures(0);
+      setError(null);
+      return;
+    }
+    const next = failures + 1;
+    setFailures(next);
+    setError('이메일 또는 비밀번호가 올바르지 않습니다.');
+    if (next >= MAX_FAILURES) {
+      setLockedUntil(Date.now() + LOCK_MS);
+      setError('잠시 후 다시 시도하세요.');
+    }
+  }
+
+  return (
+    <form action={submit} className={styles.form}>
+      <label>이메일<input name="email" type="email" /></label>
+      <label>비밀번호<input name="password" type="password" /></label>
+      {error && <p role="alert" className={styles.error}>{error}</p>}
+      <button type="submit" disabled={locked}>로그인</button>
+    </form>
+  );
+}
diff --git a/src/features/login/useLogin.ts b/src/features/login/useLogin.ts
