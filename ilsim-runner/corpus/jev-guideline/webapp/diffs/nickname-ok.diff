diff --git a/src/features/profile/NicknameForm.tsx b/src/features/profile/NicknameForm.tsx
new file mode 100644
--- /dev/null
+++ b/src/features/profile/NicknameForm.tsx
@@ -0,0 +1,19 @@
+import { useState } from 'react';
+import styles from './NicknameForm.module.css';
+import { useUpdateNickname } from './useUpdateNickname';
+
+const MIN = 2;
+const MAX = 12;
+
+export function NicknameForm({ initial }: { initial: string }) {
+  const [nickname, setNickname] = useState(initial);
+  const update = useUpdateNickname();
+  const valid = nickname.length >= MIN && nickname.length <= MAX;
+
+  return (
+    <form className={styles.form} onSubmit={(event) => { event.preventDefault(); update.mutate(nickname); }}>
+      <label>닉네임<input value={nickname} onChange={(event) => setNickname(event.target.value)} /></label>
+      <button type="submit" disabled={!valid}>저장</button>
+    </form>
+  );
+}
diff --git a/src/features/profile/useUpdateNickname.ts b/src/features/profile/useUpdateNickname.ts
new file mode 100644
--- /dev/null
+++ b/src/features/profile/useUpdateNickname.ts
@@ -0,0 +1,8 @@
+import { useMutation } from '@tanstack/react-query';
+import { apiClient } from '../../api/client';
+
+export function useUpdateNickname() {
+  return useMutation({
+    mutationFn: (nickname: string) => apiClient.put('/me/nickname', { nickname }),
+  });
+}
