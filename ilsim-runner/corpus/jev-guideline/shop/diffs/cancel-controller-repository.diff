diff --git a/src/main/java/com/shop/order/web/OrderController.java b/src/main/java/com/shop/order/web/OrderController.java
--- a/src/main/java/com/shop/order/web/OrderController.java
+++ b/src/main/java/com/shop/order/web/OrderController.java
@@ -14,3 +14,12 @@
     private final OrderService orderService;
     private final OrderRepository orderRepository;
     private final PaymentPort paymentPort;
+    @PostMapping("/orders/{orderId}/cancel")
+    public CancelOrderResponse cancel(@PathVariable Long orderId) {
+        Order order = orderRepository.findById(orderId)
+            .orElseThrow(() -> new ShopException(ErrorCode.ORDER_NOT_FOUND));
+        order.cancel();
+        paymentPort.refund(order.getPaymentId(), order.getPaidAmount());
+        orderRepository.save(order);
+        return CancelOrderResponse.from(order);
+    }
