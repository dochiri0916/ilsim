+import com.shop.order.domain.Order;
+
+public record CancelOrderResponse(Long orderId, String status, long refundedAmount) {
+
+    public static CancelOrderResponse from(Order order) {
+        return new CancelOrderResponse(order.getId(), order.getStatus().name(), order.getPaidAmount());
+    }
+}
