diff --git a/src/main/java/com/x/member/InvalidPasswordException.java b/src/main/java/com/x/member/InvalidPasswordException.java
new file mode 100644
--- /dev/null
+++ b/src/main/java/com/x/member/InvalidPasswordException.java
@@ -0,0 +1,11 @@
+package com.x.member;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.ResponseStatus;
+
+@ResponseStatus(HttpStatus.BAD_REQUEST)
+public class InvalidPasswordException extends RuntimeException {
+    public InvalidPasswordException(String message) {
+        super(message);
+    }
+}
