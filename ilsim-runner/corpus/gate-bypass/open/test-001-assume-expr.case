gate: test-integrity
path: ilsim-server/src/test/kotlin/com/x/FooTest.kt
expect: TEST-001
note: assumeTrue(1 > 2) 처럼 식으로 항상 건너뛰면 리터럴 false 패턴을 피한다
---
package com.x

import org.junit.jupiter.api.Test
import org.junit.jupiter.api.Assertions.assertEquals
import org.junit.jupiter.api.Assumptions.assumeTrue

class FooTest {
    @Test
    fun works() {
        assumeTrue(1 > 2)
        assertEquals(2, 1 + 2)
    }
}
