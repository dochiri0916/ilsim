note: assert 로 시작하는 보조 메서드 안에서 삼키면 @Test 메서드만 보는 검사가 못 본다
---
package com.x

import kotlin.test.Test
import kotlin.test.assertEquals

class FooTest {
    @Test
    fun works() {
        assertWorks()
    }

    private fun assertWorks() {
        try {
            assertEquals(4, 1 + 2)
        } catch (e: Throwable) {
        }
    }
}
