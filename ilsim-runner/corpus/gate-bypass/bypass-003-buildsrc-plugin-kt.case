gate: bypass
path: buildSrc/src/main/kotlin/TestConventionPlugin.kt
expect: BYPASS-003
note: buildSrc의 .kt 컨벤션 플러그인은 빌드 파일로 안 보여 test 작업 끄기가 통과한다
---
import org.gradle.api.Plugin
import org.gradle.api.Project
import org.gradle.api.tasks.testing.Test

class TestConventionPlugin : Plugin<Project> {
    override fun apply(project: Project) {
        project.tasks.withType(Test::class.java).configureEach { it.enabled = false }
    }
}
